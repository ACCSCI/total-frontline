{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "files": {
    "includes": [
      "**/*.js",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.ts",
      "**/*.json",
      "!node_modules",
      "!dist",
      "!campaign/dist",
      "!campaign/data",
      "!bun.lock",
      "!src",
      "!types",
      "!**/generated-*.ts",
      "!index.html",
      "!scripts/smoke.mjs",
      "!scripts/smoke-ballistics.mjs",
      "!scripts/smoke-missions.mjs",
      "!scripts/smoke-reload.mjs",
      "!scripts/smoke-smg.mjs",
      "!scripts/smoke-stance.mjs"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "off",
        "noUnusedFunctionParameters": "off"
      },
      "suspicious": {
        "noRedundantUseStrict": "off"
      },
      "style": {
        "useConst": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  }
}
